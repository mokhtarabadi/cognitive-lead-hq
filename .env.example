# Unified LLM Provider (Responses API: POST {BRAIN_API_BASE}/responses).
# Key here is a placeholder — put the real key in your private `.env`
# (git-ignored, never committed).
BRAIN_API_BASE=http://127.0.0.1:8081/zen/resp
BRAIN_API_KEY=sk-...

# Optional Direct Provider Keys
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# DEEPSEEK_API_KEY=...

# Brain Bridge (mcp-brain-bridge) — model + prompt source for `brain_turn`.
# Brain model (Responses-API id). Blank = built-in default
# (muse-spark-1.3-contributor-free).
#BRAIN_MODEL=muse-spark-1.3-contributor-free
# Reasoning effort sent as `reasoning.effort` (default xhigh).
#BRAIN_REASONING_EFFORT=xhigh
# System prompt override (absolute path). Blank = global install copy
# (~/.config/opencode/system-prompt.md).
#BRAIN_SYSTEM_PROMPT=
# Token cap per Brain turn (default 16384).
#BRAIN_MAX_TOKENS=16384

# Manager decisions (mcp-decision-server) — extraction model + temperature.
# Blank model = falls back to BRAIN_MODEL. Same Responses-API transport
# (BRAIN_API_BASE/BRAIN_API_KEY).
#DECISION_MODEL=
#DECISION_TEMPERATURE=1.0