# Unified LLM Provider (Responses API: POST {BRAIN_API_BASE}/responses).
# Must be https:// — plain http:// is allowed only for localhost/127.0.0.1
# (a local proxy); any other http:// base is refused so the API key never
# travels in cleartext. Key here is a placeholder — put the real key in
# your private `.env` (git-ignored, never committed).
BRAIN_API_BASE=https://api.openai.com/v1
BRAIN_API_KEY=sk-...

# Optional Direct Provider Keys
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# DEEPSEEK_API_KEY=...

# Brain Bridge (mcp-brain-bridge) — model + prompt source for `brain_turn`.
# Brain model (Responses-API id). Blank = built-in default
# (gpt-6-astra).
#
# RECOMMENDED MODES (verified 2026-10-30 against the live Go gateway
# through zen-proxy 127.0.0.1:8081/go/resp; all below accept
# reasoning.effort on /responses):
#
#   Default (balanced, current production setting — 2026-10-30):
#     BRAIN_MODEL=beam-free
#     BRAIN_MODEL_LOW=beam-free
#     BRAIN_MODEL_HIGH=beam-free
#     BRAIN_REASONING_EFFORT=max
#   Max quality (hard planning/review only; gpt-6-luna, 30-day logs):
#     BRAIN_MODEL=gpt-6-luna
#     BRAIN_MODEL_LOW=beam-free
#     BRAIN_MODEL_HIGH=gpt-6-luna
#     BRAIN_REASONING_EFFORT=max
#   Economy (everything cheap; weaker planning, fine for routine turns):
#     BRAIN_MODEL=muse-spark-1.3-contributor
#     BRAIN_MODEL_LOW=muse-spark-1.3-contributor
#     BRAIN_MODEL_HIGH=muse-spark-1.3-contributor
#     BRAIN_REASONING_EFFORT=xhigh
#
# Per-model notes (all on the /go/resp route):
# - beam-free: Reflection Beam 1.0 501B-A23B, Apache 2.0, 1M ctx,
#   FREE, effort low/medium/high/xhigh/max. Verified on /responses with
#   max effort. Cheap + strong reasoning. No training (logs 30d).
#   Recommended default for the Brain.
# - gpt-6-luna: strongest reasoning (#24) on /go/resp, 1.05M ctx,
#   effort none..max. 30-day log retention, no training.
#   Quota is the binding constraint: ~21k requests/month on Go $10.
# - muse-spark-1.3-contributor: TB-2.1 88.8 / DeepSWE 75.4, 1M ctx,
#   ~226k requests/month. CONTRIBUTOR tier: prompts train future Meta
#   models and are region-restricted — do not point it at private code
#   you would not share.
# - glm-5.3 (#8 agentic, TB-2.1 88.2) and kimi-k3 (#10 agentic) are
#   stronger planners but live on /go/chat only — unreachable for the
#   brain until the proxy gains a chat-route client. Do NOT set them
#   here; /responses is the only shape the bridge speaks.
# - grok-4.7: forbidden for the brain — 500K window while
#   BRAIN_CONTEXT_WINDOW_TOKENS assumes ~1M; the guard would let
#   oversized prompts through and the server rejects them.
#BRAIN_MODEL=beam-free
# Reasoning effort sent as `reasoning.effort` (default medium, the Luna
# model's own default). xhigh/max can claim roughly 95% of the token cap
# on reasoning and starve the visible answer.
#BRAIN_REASONING_EFFORT=max
# System prompt override (absolute path). Blank = global install copy
# (~/.config/opencode/system-prompt.md).
#BRAIN_SYSTEM_PROMPT=
# Token cap per Brain turn (default 32768). Reasoning tokens are billed as
# output and count against this cap, so keep it well above the expected
# reasoning length.
#BRAIN_MAX_TOKENS=32768
# Pre-send budget guard: estimate input as chars/4, add reserved
# BRAIN_MAX_TOKENS, compare against window minus margin. Blank = built-in
# defaults (1048576 window, 8192 margin). Malformed values fail loud.
#BRAIN_CONTEXT_WINDOW_TOKENS=1048576
#BRAIN_BUDGET_MARGIN_TOKENS=8192
# HTTP read timeout (seconds) for the non-streaming provider call (default
# 600 → recommended 900). Reasoning models can think for minutes before the
# single response body arrives; a deep xhigh/max turn spends 14-19K
# reasoning tokens (5-10 min), so keep this at or above the overall
# deadline below.
#BRAIN_HTTP_READ_TIMEOUT=900
# Overall deadline (seconds) for the whole retry sequence (default 900).
# Must sit at or above any proxy hop in the path (zen-proxy's
# ZEN_PROXY_UPSTREAM_TIMEOUT also defaults to 900) and below the MCP
# client's execution timeout (opencode.json `mcp.servers.brain.timeout`).
# A value below a real turn's duration surfaces as
# "provider overall deadline hit". Malformed/non-positive values fail loud.
#BRAIN_OVERALL_DEADLINE_S=900

# Responses request-shape opt-ins (Task 329; all default OFF, all probed
# HTTP 200 against the live gateway 2026-10-21). Set to 1/true/yes/on to
# enable. Default wire bytes stay identical to the pre-329 shape.
#BRAIN_SEND_STORE=0
#BRAIN_SEND_INCLUDE_ENCRYPTED=0
#BRAIN_SEND_CACHE_KEY=0
#BRAIN_SEND_TRUNCATION=0
#BRAIN_SEND_CONTEXT_MANAGEMENT=0
#BRAIN_USE_INSTRUCTIONS=0
# Estimator/token overrides. Blank = calibrated from observed
# usage.input_tokens, else 4.0. Malformed values fail loud.
#BRAIN_CHARS_PER_TOKEN=
#BRAIN_COMPACTION_THRESHOLD=100000

# Risk-aware routing (mcp-brain-bridge) — ON by default. Hard stages use the
# high model, light stages use the low one; an explicit `risk_tier` on
# `brain_turn(..., risk_tier=...)` overrides the stage-derived tier
# (T0 -> LOW, T1/T2 -> HIGH, missing/invalid -> BRAIN_MODEL).
# Stage default: plan/review -> T2 (HIGH), implement/qa/closure -> T0 (LOW);
# missing stage -> BRAIN_MODEL; an unknown stage is rejected by preflight.
# Both model ids below are also the built-in code defaults.
# Set the switch to a falsy value to disable routing (single-model behavior).
#BRAIN_RISK_ROUTING_ENABLED=true
# Tier models (production default 2026-10-21 — verified on /go/resp):
#BRAIN_MODEL_LOW=beam-free
#BRAIN_MODEL_HIGH=beam-free
# Stage->tier overrides: comma-separated `stage:Tier` pairs merged onto the
# built-in default (unusable pairs are ignored).
#BRAIN_STAGE_TIERS=plan:T2,review:T2,implement:T0,qa:T0,closure:T0

# zen-proxy (zen-proxy/ slice, services/zen-proxy.service)
# The proxy needs no API key of its own: the caller's Authorization header
# passes through. It only falls back to a session id when the client sends
# none, and keeps a tunable upstream socket timeout.
# Must stay at or below BRAIN_OVERALL_DEADLINE_S (see above): a 300s value
# here is what silently killed long reasoning turns before 2026-10-22.
#ZEN_SESSION_ID=
#ZEN_PROXY_UPSTREAM_TIMEOUT=900
# Audit writes prompts + responses to ~/.local/share/zen-proxy/audit-logs/.
#ZEN_PROXY_AUDIT=0
