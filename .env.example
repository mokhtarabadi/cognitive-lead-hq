# Cognitive Lead AI — environment reference
#
# Copy to `.env` (repo root, git-ignored) for CLI runs, or to
# `~/.config/opencode/.env` for the supervised services. Every key below is
# read by live code; a commented key shows its code default.

# ---------------------------------------------------------------------------
# Brain bridge (mcp-brain-bridge)
# ---------------------------------------------------------------------------

# Provider base. Must be https:// — plain http:// is accepted only for
# localhost/127.0.0.1 (the zen-bridge hop) so the key never travels in
# cleartext. Default: https://api.openai.com/v1
BRAIN_API_BASE=http://127.0.0.1:8081/v1

# Bearer key for the provider. Placeholder only — the real value lives in
# your private `.env`, never in git.
BRAIN_API_KEY=sk-...

# Model id sent to the provider. Default: gpt-6-astra
BRAIN_MODEL=beam-free
# Tier models used by risk-aware routing (T0 / T1-T2). Default: beam-free
BRAIN_MODEL_LOW=beam-free
BRAIN_MODEL_HIGH=beam-free
# Reasoning effort forwarded as reasoning.effort. Default: max
BRAIN_REASONING_EFFORT=max
# Stage-to-tier overrides, comma-separated stage:Tier pairs.
#BRAIN_STAGE_TIERS=qa:T2,plan:T0,review:T2,sprint:T0,brainstorm:T2,implement:T0,closure:T0,planner:T0
# Falsy value disables routing (single-model behaviour). Default: true
#BRAIN_RISK_ROUTING_ENABLED=true

# Absolute path to the system prompt. Blank = global install copy
# (~/.config/opencode/system-prompt.md).
#BRAIN_SYSTEM_PROMPT=
# Output-token cap per turn, reasoning included. Default: 32768
#BRAIN_MAX_TOKENS=32768
# Pre-send budget guard inputs. Defaults: 1048576 / 8192
#BRAIN_CONTEXT_WINDOW_TOKENS=1048576
#BRAIN_BUDGET_MARGIN_TOKENS=8192
# Per-turn input budget in chars. Blank = derived from the window.
#BRAIN_INPUT_BUDGET=
# Chars-per-token estimator. Blank = calibrated from observed usage.
#BRAIN_CHARS_PER_TOKEN=
# Compaction threshold (official minimum 1000). Default: 100000
#BRAIN_COMPACTION_THRESHOLD=100000
# Sampling temperature override. Blank = provider default.
#BRAIN_TEMPERATURE=

# Transport. LiteLLM owns the client. The bridge never retries: a failed
# turn is the caller's decision to repeat.
# Provider read timeout, seconds. Default: 600
#BRAIN_HTTP_READ_TIMEOUT=960

# Per-turn debug chatter on stderr. Default: off
#BRAIN_DEBUG=1

# Responses request-shape opt-ins (all default off).
#BRAIN_SEND_STORE=0
#BRAIN_SEND_INCLUDE_ENCRYPTED=0
#BRAIN_SEND_CACHE_KEY=0
#BRAIN_SEND_TRUNCATION=0
#BRAIN_SEND_CONTEXT_MANAGEMENT=0
#BRAIN_USE_INSTRUCTIONS=0

# Context attachment caps, chars.
#BRAIN_TASK_ATTACH_CAP=
#BRAIN_TASK_DIFF_CAP=
#BRAIN_CTX_PER_FILE_CAP=
#BRAIN_CTX_TOTAL_CAP=
# Oversized-result stubbing caps. Defaults: files 20, inline 20000
#BRAIN_OUTPUTS_MAX_FILES=
#BRAIN_OUTPUTS_MAX_BYTES=
#BRAIN_OUTPUT_INLINE_MAX=

# Usage ledger: where the monthly counter lives and its warn/cap values.
#BRAIN_USAGE_ROOT=
#BRAIN_QUOTA_CAP=
#BRAIN_QUOTA_WARN_AT=

# Session and workspace roots. Blank = resolved per project.
#BRAIN_SESSIONS_ROOT=
#BRAIN_PROJECT_ROOT=
#BRAIN_WORKSPACE_ROOT=

# Outbound proxy for a non-loopback provider base. Loopback is always
# exempt (127.0.0.1 / localhost / ::1 are forced into no_proxy).
#BRAIN_HTTPS_PROXY=http://127.0.0.1:7890
#BRAIN_HTTP_PROXY=http://127.0.0.1:7890

# ---------------------------------------------------------------------------
# zen-bridge (loopback provider bridge, 127.0.0.1:8081)
# ---------------------------------------------------------------------------

# Upstream OpenCode gateway roots.
#OPENCODE_BASE=https://opencode.ai
#OPENCODE_MODELS_HOST=https://models.opencode.ai
# Loopback listen port. Default: 8081
#PORT=8081
# Fallback key when the caller sends no Authorization header.
#OPENCODE_API_KEY=
# Client identity sent upstream.
#OPENCODE_CLIENT=cli
#OPENCODE_CHANNEL=latest
#OPENCODE_VERSION=2.3.2
#OPENCODE_NAME=cli
#OPENCODE_PROJECT_ID=global

# Upstream silence timeout, seconds. Default: 900
#ZEN_BRIDGE_UPSTREAM_TIMEOUT=900
# Legacy alias kept for older units; ZEN_BRIDGE_UPSTREAM_TIMEOUT wins.
#UPSTREAM_TIMEOUT_SEC=900
# Inbound body cap, bytes. Default: 33554432
#ZEN_BRIDGE_MAX_BODY_BYTES=33554432

# Gateway egress proxy. Order: ZEN_BRIDGE_* then lowercase then uppercase.
# Loopback is never proxied.
#ZEN_BRIDGE_HTTPS_PROXY=http://127.0.0.1:7890
#ZEN_BRIDGE_HTTP_PROXY=http://127.0.0.1:7890
#ZEN_BRIDGE_NO_PROXY=localhost,127.0.0.1,::1

# ---------------------------------------------------------------------------
# MCP servers (mcp-* slices) — only when serving over HTTP
# ---------------------------------------------------------------------------

#MCP_TRANSPORT=http
#MCP_HOST=127.0.0.1
#MCP_PORT=8105

# ---------------------------------------------------------------------------
# Planner (mcp-planner-server)
# ---------------------------------------------------------------------------

#PLANNER_DAILY_TARGET=
#PLANNER_WEEKLY_CAPACITY=

# ---------------------------------------------------------------------------
# Telegram (mcp-telegram-server)
# ---------------------------------------------------------------------------

#TELEGRAM_ALLOW_SERVER_ROOTS_FALLBACK=0

# ---------------------------------------------------------------------------
# blowsh (Docker) — direct by default, any HTTP proxy by env
# ---------------------------------------------------------------------------

#PROXY_TYPE=none
#PROXY_HOST=
#PROXY_PORT=
#PROXY_BYPASS=localhost,127.0.0.1
