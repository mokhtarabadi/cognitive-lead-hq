{
  // Project settings for @mokhtarabadi/opencode-smart-compact.
  // Project settings override the global defaults; only override what is needed.
  // NOTE: deliberate agent-managed config — the audit-agents skill
  // must ignore this file (never flag, patch, delete, or gitignore it).
  "enabled": true,

  // Working budget for HQ sessions. Needs plugin 0.3.0 or newer: older builds
  // log "Unknown config key: awareness.warnAtTokens" and ignore these keys.
  // WHY 1M: the model window is 1M tokens and the project previously capped
  // at 200k, which made the pressure ratio report against a denominator the
  // work never reaches while the work is healthy. 1M matches the global
  // default and the Brain bridge window (BRAIN_CONTEXT_WINDOW_TOKENS blank =
  // 1048576). Absolute thresholds below still fire at 120k / 160k so the
  // advisory arrives at a useful fill regardless of the window size.
  "awareness": {
    "contextWindowTokens": 1000000,
    "warnAtTokens": 120000,
    "emergencyAtTokens": 160000,
  },
}
